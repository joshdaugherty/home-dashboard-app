APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# [Laravel Cloud: set as a CUSTOM variable. Cloud injects SESSION_DRIVER=cookie, which would be
#  unrevocable; this overrides it so sessions live in the database.]
SESSION_DRIVER=database
# [Laravel Cloud: set as a CUSTOM variable. Minutes; 525600 = 1 year, so the frame stays logged in.]
SESSION_LIFETIME=525600
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Home dashboard (package: joshdaugherty/home-dashboard)
#
# Laravel Cloud > Settings > General > Custom environment variables. Set these there:
#   SESSION_DRIVER, SESSION_LIFETIME (above), DASHBOARD_USER_EMAIL, DASHBOARD_USER_PASSWORD
#   and, as the tabs land: DASHBOARD_LATITUDE, DASHBOARD_LONGITUDE, DASHBOARD_TIMEZONE, DASHBOARD_CALENDARS, DASHBOARD_NASA_KEY
# Everything else (DB_*, CACHE_STORE, ...) is injected by Cloud from attached resources; leave it alone.
# Redeploy after changing any of them. Never commit real values.
DASHBOARD_TITLE=Home
DASHBOARD_USER_NAME=Family
# [Cloud custom variable] The login. php artisan home-dashboard:user creates/updates it on every deploy.
DASHBOARD_USER_EMAIL=
DASHBOARD_USER_PASSWORD=

# [Cloud custom variable, planned] Weather location for the Today tab (Open-Meteo, no API key).
# DASHBOARD_LATITUDE=
# DASHBOARD_LONGITUDE=
# DASHBOARD_TIMEZONE=America/New_York

# [Cloud custom variable, planned] Calendar tab: one-line JSON list of read-only iCal feeds.
# Wrap the JSON in single quotes (Cloud's editor requires quotes around values with spaces).
# Entries with a blank url are skipped, so placeholders are fine.
# DASHBOARD_CALENDARS='[{"name":"Family","color":"sky","url":"https://..."}]'
# Optional: a free NASA key (https://api.nasa.gov) adds NASA's Astronomy Picture of the Day to the Today background on alternate hours.
# Treat it like a password: set it as a Cloud custom variable, not in the repo.
# DASHBOARD_NASA_KEY=

# Shopping and Meals tabs: a Notion internal integration secret (treat it like a password; on Cloud it is a custom variable).
# The database ids default to config/home-dashboard.php; override with NOTION_AISLES, NOTION_ITEMS, NOTION_MEALS, NOTION_PLAN.
# NOTION_TOKEN=
